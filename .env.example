# Copy to .env.local (or set in Vercel → Project → Environment Variables).
# Both are optional — the site runs without them; analytics activate when set.

# GA4 measurement ID, e.g. G-XXXXXXXXXX (create at analytics.google.com)
NEXT_PUBLIC_GA_ID=

# Meta Pixel ID (create at business.facebook.com → Events Manager)
NEXT_PUBLIC_META_PIXEL_ID=

# Google Search Console "HTML tag" verification code — the content="..." value
# from Search Console → Settings → Ownership verification → HTML tag.
# Optional: if you verify zivasha.in via DNS record instead, leave this unset.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
